# Block direct web access to sensitive files
<FilesMatch "(\.(env|log|bat|ini|git.*|sh)|package\.json|package-lock\.json|tsconfig\.json)$">
    Require all denied
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass through existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Clean extensionless URLs (e.g. /landing -> landing.html, /privacy -> privacy.html)
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.html [L]
</IfModule>
